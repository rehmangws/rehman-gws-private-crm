# ==========================================
# REHMAN GWS — PRIVATE LEAD OPERATIONS CRM
# Environment Configuration Specification
# ==========================================

# Core CRM runs out-of-the-box with zero paid APIs (Carto/OSM mapping & Local-First persistence).
# The variables below are for optional cloud sync and external discovery integrations.

# --- Optional Firebase Configuration (Frontend Safe) ---
# Enables live Firestore cloud synchronization and Firebase Authentication.
# If omitted, the CRM gracefully operates in high-performance local-first persistence mode.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="rehman-gws-crm.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="rehman-gws-crm"
VITE_FIREBASE_STORAGE_BUCKET="rehman-gws-crm.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef"

# --- Optional Google Places API (Optional Discovery) ---
# Used strictly for automated external business discovery in the Lead Generator.
# Core CRM and World Lead Map do NOT require this key.
VITE_GOOGLE_PLACES_API_KEY=""

# --- System URLs ---
APP_URL="https://crm.rehmangws.com"
